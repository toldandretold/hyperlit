APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# PRODUCTION: Set APP_DEBUG=false to hide stack traces and sensitive info
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hyperlit

# Application database user (restricted, RLS enforced)
DB_USERNAME=hyperlit_app
DB_PASSWORD=your_app_password

# Admin database user (superuser, for migrations only)
# Falls back to DB_USERNAME/DB_PASSWORD if not set
DB_ADMIN_USERNAME=hyperlit_admin
DB_ADMIN_PASSWORD=your_admin_password

SESSION_DRIVER=rls-database
SESSION_LIFETIME=120
# PRODUCTION: Set SESSION_ENCRYPT=true to encrypt session data
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

## Local dev: install Mailpit (`brew install mailpit`) then run `mailpit`.
## Web UI at http://localhost:8025 — all outbound mail is captured there.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@hyperlit.com"
MAIL_FROM_NAME="Hyperlit"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

LLM_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_API_KEY=

# Per-node TTS audiobooks (Kokoro-82M via DeepInfra). Base URL defaults to the
# Kokoro inference endpoint; this key is a DeepInfra key, not the LLM one.
TTS_API_KEY=
# TTS_PROVIDER=deepinfra
# TTS_BASE_URL=https://api.deepinfra.com/v1/inference/hexgrad/Kokoro-82M
# TTS_DEFAULT_VOICE=af_heart

# Machine translation. hosted | ollama | dedicated (see config/services.php).
# 'hosted' needs no extra config — it reuses LLM_BASE_URL + LLM_API_KEY and only
# the model differs. It is also the only provider BYO inference tickets traverse.
TRANSLATION_PROVIDER=hosted
# TRANSLATION_MODEL=accounts/fireworks/models/gpt-oss-120b
#   ⚠ Repointing LLM_BASE_URL at DeepInfra (https://api.deepinfra.com/v1/openai)
#   means setting TRANSLATION_MODEL=google/gemma-4-31B-it too — the Fireworks id
#   404s there. Fireworks serves gemma-4-31b-it on dedicated GPUs only.
#
# 'ollama' — a local specialised translation model, free, and the only provider
# that can translate an E2EE book (its plaintext must never reach the server):
#   ollama pull translategemma:4b        # ~2.5GB q4, comfortable on 16GB
#   ollama pull translategemma:12b       # ~7.3GB q4 — cap the context, see below
# TRANSLATION_OLLAMA_BASE_URL=http://localhost:11434/v1
# TRANSLATION_OLLAMA_MODEL=translategemma:4b
# TRANSLATION_OLLAMA_SHAPE=auto          # auto | structured | instruction
#   TranslateGemma's 128K window will exhaust unified memory on a 16GB machine
#   through KV cache alone — run ollama with OLLAMA_CONTEXT_LENGTH=8192.
#
# 'dedicated' — any OpenAI-compatible endpoint: a rented DeepInfra custom-LLM
# deployment (billed per GPU-hour, min_instances 0 scales to zero) or your own
# box over Tailscale. Billing is waived: a GPU-hour has no per-token rate.
# TRANSLATION_DEDICATED_BASE_URL=
# TRANSLATION_DEDICATED_API_KEY=
# TRANSLATION_DEDICATED_MODEL=

MISTRAL_OCR_API_KEY=

# On-device PDF OCR (Mac-hosted backends only). Build the CLI with
# macOShyperlit/build-cli.sh, then point NATIVE_OCR_BINARY at
# macOShyperlit/bin/hyperlit-ocr. OCR_PROVIDER: auto | native | mistral.
NATIVE_OCR_BINARY=
OCR_PROVIDER=auto

BRAVE_SEARCH_API_KEY=

SEMANTIC_SCHOLAR_API_KEY=

# Open-access PDF fetching (see deploy/oa-fetch-hardening.md)
# Unpaywall is keyless but requires a contact email query param.
UNPAYWALL_EMAIL=
# Self-hosted FlareSolverr for Cloudflare-challenged OA PDFs. Unset = the
# solver strategy no-ops. e.g. http://127.0.0.1:8191
FLARESOLVERR_URL=
FLARESOLVERR_MAX_TIMEOUT=60000
# Optional residential/rotating proxy for OA fetches + the browser scripts.
# Cloudflare hard-blocks datacenter IPs; a residential egress is the real fix.
# e.g. http://user:pass@host:port
SOURCE_FETCH_PROXY=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
